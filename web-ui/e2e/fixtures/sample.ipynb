   "source": [
    "# RRF 评测\n",
    "\n",
    "对比 **k** 值：`20 / 60 / 100`。\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {},
   "source": [
    "import math\n",
    "def rrf(rank, k=60):\n",
    "    return 1 / (k + rank)\n",
    "print(rrf(1))"
   ],
