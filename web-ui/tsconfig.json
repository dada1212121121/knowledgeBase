{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@kb-ui/*": ["packages/kb-ui/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "packages/kb-ui/src/**/*.ts", "packages/kb-ui/src/**/*.vue"]
}
